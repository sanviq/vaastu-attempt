# Copy this file to secrets.toml and fill in your Razorpay TEST keys.
# Dashboard → Settings → API Keys → Generate Test Key
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Never commit secrets.toml — it is listed in .gitignore.

[razorpay]
key_id = "rzp_test_xxxxxxxx"
key_secret = "your_test_key_secret_here"
